<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QueryMongo.App.Views"
    xmlns:ws="using:QueryMongo.App.Views.Workspaces">

    <!--
        Which view renders which workspace. This is the counterpart of Compass's workspace
        registry, where every workspace type names its own component.

        The templates are keyed rather than set on the selector in markup, and the shell
        assembles the selector from them, which keeps each workspace's view in one obvious
        place while staying inside what the XAML binary format supports.
    -->

    <DataTemplate x:Key="WelcomeWorkspaceTemplate">
        <ws:WelcomeWorkspaceView Model="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="MyQueriesWorkspaceTemplate">
        <ws:MyQueriesWorkspaceView Model="{Binding Queries}" />
    </DataTemplate>

    <DataTemplate x:Key="DatabasesWorkspaceTemplate">
        <ws:DatabasesWorkspaceView Model="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="CollectionsWorkspaceTemplate">
        <ws:CollectionsWorkspaceView Model="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="CollectionWorkspaceTemplate">
        <views:CollectionTabView Tab="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="ShellWorkspaceTemplate">
        <ws:ShellWorkspaceView Model="{Binding Shell}" />
    </DataTemplate>

    <DataTemplate x:Key="PerformanceWorkspaceTemplate">
        <ws:PerformanceWorkspaceView Model="{Binding Performance}" />
    </DataTemplate>

</ResourceDictionary>
