<Window
    x:Class="QueryMongo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QueryMongo.App.Views"
    xmlns:c="using:QueryMongo.App.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: dragging happens on this strip. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <FontIcon Glyph="&#xE8A5;" FontSize="14"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="QueryMongo" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Shell.ServerDescription, Mode=OneWay}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <views:ConnectView Grid.Row="1" Shell="{x:Bind Shell}"
                           Visibility="{x:Bind c:Converters.Visible(Shell.IsDisconnected), Mode=OneWay}" />

        <views:WorkspaceView Grid.Row="1" Shell="{x:Bind Shell}"
                             Visibility="{x:Bind c:Converters.Visible(Shell.IsConnected), Mode=OneWay}" />
    </Grid>
</Window>
