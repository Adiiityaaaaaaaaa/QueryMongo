<Window
    x:Class="QueryMongo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QueryMongo.App.Views">

    <Grid x:Name="RootGrid" Background="{ThemeResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the strip the window is dragged by. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="36"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                        Spacing="8">
                <TextBlock Text="QueryMongo" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SidebarTextBrush}" />
            </StackPanel>
        </Grid>

        <views:WorkspaceView Grid.Row="1" Shell="{x:Bind Shell}" />
    </Grid>
</Window>
