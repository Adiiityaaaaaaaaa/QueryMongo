<ContentDialog
    x:Class="QueryMongo.App.Dialogs.ConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New connection"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="14" Width="560">

            <Pivot>
                <PivotItem Header="Connection">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock Text="URI" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox x:Name="UriBox" Style="{StaticResource CodeTextBoxStyle}"
                                     PlaceholderText="mongodb://localhost:27017" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource InkFaintBrush}"
                                       Text="Supports mongodb:// and mongodb+srv://. Add ?authSource=admin when authenticating against the admin database." />
                        </StackPanel>

                        <TextBox x:Name="NameBox" Header="Display name (optional)"
                                 PlaceholderText="Taken from the host if left blank" />

                        <!--
                            A colour tag, as in Compass. It tints the connection's rows in
                            the sidebar and the top edge of its tabs, so a production
                            deployment is obvious before a query runs against it.
                        -->
                        <ComboBox x:Name="ColorBox" Header="Colour" SelectedIndex="0"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="None" Tag="" />
                            <ComboBoxItem Content="Green" Tag="color1" />
                            <ComboBoxItem Content="Teal" Tag="color2" />
                            <ComboBoxItem Content="Blue" Tag="color3" />
                            <ComboBoxItem Content="Iris" Tag="color4" />
                            <ComboBoxItem Content="Purple" Tag="color5" />
                            <ComboBoxItem Content="Red" Tag="color6" />
                            <ComboBoxItem Content="Pink" Tag="color7" />
                            <ComboBoxItem Content="Orange" Tag="color8" />
                            <ComboBoxItem Content="Yellow" Tag="color9" />
                        </ComboBox>
                    </StackPanel>
                </PivotItem>

                <PivotItem Header="SSH tunnel">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <CheckBox x:Name="UseSshCheck" Content="Connect through an SSH bastion"
                                  Checked="OnSshToggled" Unchecked="OnSshToggled" />

                        <StackPanel x:Name="SshPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SshHostBox" Grid.Column="0" Header="Bastion host"
                                         PlaceholderText="bastion.example.com" />
                                <NumberBox x:Name="SshPortBox" Grid.Column="1" Header="Port" Value="22"
                                           Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            </Grid>

                            <TextBox x:Name="SshUserBox" Header="Username" PlaceholderText="ubuntu" />

                            <RadioButtons x:Name="SshAuthButtons" SelectedIndex="0" Header="Authentication"
                                          SelectionChanged="OnSshAuthChanged">
                                <x:String>Password</x:String>
                                <x:String>Private key</x:String>
                            </RadioButtons>

                            <PasswordBox x:Name="SshPasswordBox" Header="Password" />

                            <StackPanel x:Name="SshKeyPanel" Spacing="10" Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SshKeyPathBox" Grid.Column="0" Header="Private key file"
                                             PlaceholderText="C:\Users\you\.ssh\id_ed25519" />
                                    <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseKey" />
                                </Grid>
                                <PasswordBox x:Name="SshPassphraseBox" Header="Key passphrase (optional)" />
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SshRemoteHostBox" Grid.Column="0"
                                         Header="MongoDB host, as seen from the bastion" Text="127.0.0.1" />
                                <NumberBox x:Name="SshRemotePortBox" Grid.Column="1" Header="MongoDB port"
                                           Value="27017" Minimum="1" Maximum="65535"
                                           SpinButtonPlacementMode="Compact" />
                            </Grid>

                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource InkFaintBrush}"
                                       Text="The URI is rewritten to the local end of the tunnel, keeping its credentials and options. An SRV URI becomes a direct host, since one tunnel cannot represent a resolved host list." />
                        </StackPanel>
                    </StackPanel>
                </PivotItem>
            </Pivot>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False"
                     Title="Could not connect" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
