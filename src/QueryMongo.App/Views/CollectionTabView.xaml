<UserControl
    x:Class="QueryMongo.App.Views.CollectionTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels"
    xmlns:conn="using:QueryMongo.Core.Connections"
    xmlns:svc="using:QueryMongo.Core.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Collection header -->
        <Grid Grid.Row="0" Padding="20,10,20,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{x:Bind Tab.Namespace}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Tab.StatsSummary, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Import" Click="OnImport" />
                <Button Content="Export" Click="OnExport" />
                <Button Command="{x:Bind Tab.LoadStatsCommand}" ToolTipService.ToolTip="Refresh stats">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Panes -->
        <Pivot Grid.Row="1" Padding="12,0,0,0" SelectionChanged="OnPaneChanged">

            <!-- ==================== Documents ==================== -->
            <PivotItem Header="Documents">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Query bar -->
                    <StackPanel Grid.Row="0" Spacing="8" Padding="0,0,12,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Header="Filter"
                                     Style="{StaticResource CodeTextBoxStyle}"
                                     PlaceholderText="{}{ field: value }"
                                     Text="{x:Bind Tab.Documents.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnFilterKeyDown" />

                            <Button Grid.Column="1" Content="Find" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind Tab.Documents.RunQueryCommand}" />

                            <Button Grid.Column="2" Content="Reset" VerticalAlignment="Bottom"
                                    Command="{x:Bind Tab.Documents.ResetQueryCommand}" />

                            <Button Grid.Column="3" VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Query history and favourites">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Width="460" Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Recent and saved"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource SectionHeaderStyle}" />
                                                <Button Grid.Column="1" Content="Save current" FontSize="12"
                                                        Click="OnSaveFavorite" />
                                                <Button Grid.Column="2" Content="Clear" FontSize="12"
                                                        Command="{x:Bind Tab.Documents.ClearHistoryCommand}" />
                                            </Grid>

                                            <ListView ItemsSource="{x:Bind Tab.Documents.History}"
                                                      SelectionMode="None" MaxHeight="320">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="conn:SavedQuery">
                                                        <Grid ColumnSpacing="8" Padding="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Visibility="{x:Bind c:Converters.NotEmpty(Name)}" />
                                                                <TextBlock Text="{x:Bind Summary}"
                                                                           Style="{StaticResource CodeTextBlockStyle}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Use" FontSize="11"
                                                                    Padding="8,2" Tag="{x:Bind}"
                                                                    Click="OnUseSavedQuery" />
                                                            <Button Grid.Column="2" FontSize="11" Padding="6,2"
                                                                    Tag="{x:Bind}" Click="OnDeleteSavedQuery">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="4" VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="More actions">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Insert document" Click="OnInsertDocument">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Update matching documents" Click="OnUpdateMany" />
                                        <MenuFlyoutItem Text="Delete matching documents" Click="OnDeleteMany">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Export query to language" Click="OnExportQuery" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Expand all" Command="{x:Bind Tab.Documents.ExpandAllCommand}" />
                                        <MenuFlyoutItem Text="Collapse all" Command="{x:Bind Tab.Documents.CollapseAllCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Expander Header="Project, sort, collation and paging" HorizontalAlignment="Stretch"
                                  IsExpanded="{x:Bind Tab.Documents.IsQueryBarExpanded, Mode=TwoWay}">
                            <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" Header="Project"
                                         Style="{StaticResource CodeTextBoxStyle}"
                                         PlaceholderText="{}{ field: 1 }"
                                         Text="{x:Bind Tab.Documents.Projection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Header="Sort"
                                         Style="{StaticResource CodeTextBoxStyle}"
                                         PlaceholderText="{}{ field: -1 }"
                                         Text="{x:Bind Tab.Documents.Sort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox Grid.Row="0" Grid.Column="2" Header="Limit" Minimum="1" Maximum="1000"
                                           SpinButtonPlacementMode="Compact" Width="100"
                                           Value="{x:Bind Tab.Documents.Limit, Mode=TwoWay}" />
                                <NumberBox Grid.Row="0" Grid.Column="3" Header="Skip" Minimum="0"
                                           SpinButtonPlacementMode="Compact" Width="100"
                                           Value="{x:Bind Tab.Documents.Skip, Mode=TwoWay}" />

                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Collation"
                                         Style="{StaticResource CodeTextBoxStyle}"
                                         PlaceholderText="{}{ locale: 'en' }"
                                         Text="{x:Bind Tab.Documents.Collation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <!-- Messages and view switcher -->
                    <StackPanel Grid.Row="1" Spacing="6" Padding="0,0,12,0">
                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Documents.ErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind Tab.Documents.ErrorMessage, Mode=OneWay}" />

                        <InfoBar Severity="Success" IsClosable="True"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Documents.StatusMessage), Mode=OneWay}"
                                 Message="{x:Bind Tab.Documents.StatusMessage, Mode=OneWay}" />

                        <InfoBar Severity="Warning" IsClosable="False" Title="Collection scan"
                                 IsOpen="{x:Bind Tab.ShowCollectionScanWarning, Mode=OneWay}"
                                 Message="This query has no usable index, so the server reads every document. Add an index on the filtered fields." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                                <Button Content="List" Click="OnShowList" Padding="12,4" />
                                <Button Content="Table" Click="OnShowTable" Padding="12,4" />
                                <Button Content="JSON" Click="OnShowJson" Padding="12,4" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Tab.Documents.ResultSummary, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Results -->
                    <Grid Grid.Row="2">

                        <!-- List view -->
                        <ListView ItemsSource="{x:Bind Tab.Documents.Documents}" SelectionMode="None"
                                  Padding="0,0,12,0"
                                  Visibility="{x:Bind c:Converters.Visible(Tab.Documents.IsListMode), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentViewModel">
                                    <Expander HorizontalAlignment="Stretch" Margin="0,2"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8" Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind IdDescription}" FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Preview}"
                                                               Style="{StaticResource CodeTextBlockStyle}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <Button Tag="{x:Bind}" Click="OnEditDocument" Padding="6,2"
                                                            ToolTipService.ToolTip="Edit">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="OnCloneDocument" Padding="6,2"
                                                            ToolTipService.ToolTip="Clone">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="OnCopyDocument" Padding="6,2"
                                                            ToolTipService.ToolTip="Copy JSON">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="OnDeleteDocument" Padding="6,2"
                                                            ToolTipService.ToolTip="Delete">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>

                                        <StackPanel Spacing="8">
                                            <!-- Read-only body -->
                                            <TextBlock Text="{x:Bind Json}"
                                                       Style="{StaticResource CodeTextBlockStyle}"
                                                       Visibility="{x:Bind c:Converters.Visible(IsReadOnly), Mode=OneWay}" />

                                            <!-- Editor -->
                                            <StackPanel Spacing="8"
                                                        Visibility="{x:Bind c:Converters.Visible(IsEditing), Mode=OneWay}">
                                                <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                                                         FontFamily="{StaticResource CodeFontFamily}" FontSize="12"
                                                         Text="{x:Bind EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <InfoBar Severity="Error" IsClosable="False"
                                                         IsOpen="{x:Bind c:Converters.HasText(EditError), Mode=OneWay}"
                                                         Message="{x:Bind EditError, Mode=OneWay}" />

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                                                            Tag="{x:Bind}" Click="OnSaveDocument" />
                                                    <Button Content="Cancel" Tag="{x:Bind}" Click="OnCancelEdit" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Table view -->
                        <Grid Visibility="{x:Bind c:Converters.Visible(Tab.Documents.IsTableMode), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="HeaderScroll" Grid.Row="0" HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{x:Bind Tab.Documents.Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Width="180" Padding="8,6"
                                                    BorderThickness="0,0,1,1"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          ViewChanged="OnTableScrolled">
                                <ItemsControl ItemsSource="{x:Bind Tab.Documents.Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DocumentViewModel">
                                            <ItemsControl ItemsSource="{x:Bind Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DocumentCell">
                                                        <Border Width="180" Padding="8,5"
                                                                BorderThickness="0,0,1,1"
                                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                            <TextBlock Text="{x:Bind Value}" FontSize="12"
                                                                       FontFamily="{StaticResource CodeFontFamily}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- JSON view -->
                        <ScrollViewer Padding="0,0,12,0"
                                      Visibility="{x:Bind c:Converters.Visible(Tab.Documents.IsJsonMode), Mode=OneWay}">
                            <TextBox Text="{x:Bind Tab.Documents.RawJson, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="{StaticResource CodeFontFamily}" FontSize="12"
                                     BorderThickness="0" Background="Transparent" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Paging -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Padding="0,0,0,12">
                        <Button Content="Previous" Command="{x:Bind Tab.Documents.PreviousPageCommand}"
                                IsEnabled="{x:Bind Tab.Documents.CanGoBack, Mode=OneWay}" />
                        <Button Content="Next" Command="{x:Bind Tab.Documents.NextPageCommand}"
                                IsEnabled="{x:Bind Tab.Documents.HasMore, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind Tab.Documents.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <!-- ==================== Aggregations ==================== -->
            <PivotItem Header="Aggregations">
                <Grid ColumnSpacing="12" Padding="0,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Run" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind Tab.Aggregation.RunCommand}" />
                            <Button Content="Preview stages"
                                    Command="{x:Bind Tab.Aggregation.PreviewStagesCommand}" />
                            <Button Content="Explain" Command="{x:Bind Tab.Aggregation.ExplainCommand}" />
                            <Button Content="Add stage" Click="OnAddStage" />
                            <Button Content="Text mode" Command="{x:Bind Tab.Aggregation.ToggleTextModeCommand}" />
                            <Button Content="Export to language" Click="OnExportPipeline" />
                            <Button Content="Clear" Command="{x:Bind Tab.Aggregation.ClearPipelineCommand}" />
                            <ProgressRing IsActive="{x:Bind Tab.Aggregation.IsBusy, Mode=OneWay}"
                                          Width="16" Height="16" />
                        </StackPanel>

                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Aggregation.ErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind Tab.Aggregation.ErrorMessage, Mode=OneWay}" />

                        <InfoBar Severity="Warning" IsClosable="False" Title="This pipeline writes data"
                                 IsOpen="{x:Bind Tab.Aggregation.WritesToCollection, Mode=OneWay}"
                                 Message="{x:Bind Tab.Aggregation.StatusMessage, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="Run and save" Click="OnRunWritingPipeline" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>

                    <!-- Stage list -->
                    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind c:Converters.Hidden(Tab.Aggregation.IsTextMode), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind Tab.Aggregation.Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineStageViewModel">
                                    <Border Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel>
                                            <Grid Padding="10,8" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" MinWidth="0"
                                                          IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                          ToolTipService.ToolTip="Include this stage" />

                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Bind vm:PipelineStageViewModel.Operators}"
                                                          SelectedItem="{x:Bind Operator, Mode=TwoWay}" />

                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Text="{x:Bind PreviewSummary, Mode=OneWay}" />

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                    <Button Padding="6,2" Tag="{x:Bind}" Click="OnStageUp"
                                                            ToolTipService.ToolTip="Move up">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                    </Button>
                                                    <Button Padding="6,2" Tag="{x:Bind}" Click="OnStageDown"
                                                            ToolTipService.ToolTip="Move down">
                                                        <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                    </Button>
                                                    <Button Padding="6,2" Tag="{x:Bind}" Click="OnStageDuplicate"
                                                            ToolTipService.ToolTip="Duplicate">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    </Button>
                                                    <Button Padding="6,2" Tag="{x:Bind}" Click="OnStageRemove"
                                                            ToolTipService.ToolTip="Remove">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBox Margin="10,0,10,8" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="90"
                                                     FontFamily="{StaticResource CodeFontFamily}" FontSize="12"
                                                     Text="{x:Bind Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <InfoBar Margin="10,0,10,8" Severity="Error" IsClosable="False"
                                                     IsOpen="{x:Bind c:Converters.HasText(Error), Mode=OneWay}"
                                                     Message="{x:Bind Error, Mode=OneWay}" />

                                            <ItemsControl ItemsSource="{x:Bind Preview}" Margin="10,0,10,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DocumentViewModel">
                                                        <TextBlock Text="{x:Bind Preview}" Margin="0,2"
                                                                   Style="{StaticResource CodeTextBlockStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Text mode -->
                    <TextBox Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource CodeFontFamily}" FontSize="12"
                             Visibility="{x:Bind c:Converters.Visible(Tab.Aggregation.IsTextMode), Mode=OneWay}"
                             Text="{x:Bind Tab.Aggregation.TextPipeline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Results -->
                    <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Tab.Aggregation.ResultSummary, Mode=OneWay}" />

                        <ListView Grid.Row="1" ItemsSource="{x:Bind Tab.Aggregation.Results}" SelectionMode="None"
                                  BorderThickness="1" CornerRadius="6"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentViewModel">
                                    <TextBlock Text="{x:Bind Json}" Margin="0,4"
                                               Style="{StaticResource CodeTextBlockStyle}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- ==================== Schema ==================== -->
            <PivotItem Header="Schema">
                <Grid RowSpacing="8" Padding="0,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Header="Filter (optional)"
                                 Style="{StaticResource CodeTextBoxStyle}"
                                 Text="{x:Bind Tab.Schema.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox Grid.Column="1" Header="Sample size" Minimum="10" Maximum="100000"
                                   Width="130" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Tab.Schema.SampleSize, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="Analyze" VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Tab.Schema.AnalyzeCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="{x:Bind Tab.Schema.Summary, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind c:Converters.Visible(Tab.Schema.IsBusy), Mode=OneWay}" />
                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Schema.ErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind Tab.Schema.ErrorMessage, Mode=OneWay}" />
                    </StackPanel>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Tab.Schema.Fields}" SelectionMode="None"
                              BorderThickness="1" CornerRadius="6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchemaFieldViewModel">
                                <Grid ColumnSpacing="16" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Path}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind MixedTypeWarning}" FontSize="10"
                                                   Visibility="{x:Bind c:Converters.Visible(HasMixedTypes)}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind DominantType}" FontSize="12"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                        <ProgressBar Value="{x:Bind PresencePercent}" Maximum="100" Height="4" />
                                        <TextBlock Text="{x:Bind PresenceDescription}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind Examples}" FontSize="11"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource CodeFontFamily}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ==================== Explain ==================== -->
            <PivotItem Header="Explain">
                <Grid RowSpacing="8" Padding="0,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <Button Content="Refresh" Command="{x:Bind Tab.RefreshExplainCommand}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Explains the query currently in the Documents tab." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{x:Bind Tab.ExplainDescription, Mode=OneWay}"
                                   Style="{StaticResource CodeTextBlockStyle}" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- ==================== Indexes ==================== -->
            <PivotItem Header="Indexes">
                <Grid RowSpacing="8" Padding="0,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Tab.Indexes.Summary, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="Create index"
                                Style="{StaticResource AccentButtonStyle}" Click="OnCreateIndex" />
                        <Button Grid.Column="2" Command="{x:Bind Tab.Indexes.RefreshCommand}"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind Tab.Indexes.Indexes}" SelectionMode="None"
                              BorderThickness="1" CornerRadius="6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:IndexDetail">
                                <Grid ColumnSpacing="16" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{x:Bind KeyDescription}"
                                                   Style="{StaticResource CodeTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Properties}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeDescription}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind UsageDescription}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <Button Grid.Column="4" Content="Drop" FontSize="11" Padding="10,3"
                                            IsEnabled="{x:Bind CanDrop}" Tag="{x:Bind}" Click="OnDropIndex" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ==================== Validation ==================== -->
            <PivotItem Header="Validation">
                <Grid ColumnSpacing="12" RowSpacing="8" Padding="0,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Header="Level" Width="130" ItemsSource="{x:Bind svc:ValidationRules.Levels}"
                                      SelectedItem="{x:Bind Tab.Validation.Level, Mode=TwoWay}" />
                            <ComboBox Header="Action" Width="130" ItemsSource="{x:Bind svc:ValidationRules.Actions}"
                                      SelectedItem="{x:Bind Tab.Validation.Action, Mode=TwoWay}" />
                            <Button Content="Preview" VerticalAlignment="Bottom"
                                    Command="{x:Bind Tab.Validation.PreviewCommand}" />
                            <Button Content="Apply" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnApplyValidation" />
                            <Button Content="Remove rules" VerticalAlignment="Bottom" Click="OnClearValidation" />
                        </StackPanel>

                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Validation.ErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind Tab.Validation.ErrorMessage, Mode=OneWay}" />

                        <InfoBar Severity="Informational" IsClosable="False"
                                 IsOpen="{x:Bind c:Converters.HasText(Tab.Validation.PreviewSummary), Mode=OneWay}"
                                 Message="{x:Bind Tab.Validation.PreviewSummary, Mode=OneWay}" />
                    </StackPanel>

                    <TextBox Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource CodeFontFamily}" FontSize="12"
                             Text="{x:Bind Tab.Validation.RulesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock Text="Passing sample" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView ItemsSource="{x:Bind Tab.Validation.Passing}" SelectionMode="None"
                                      BorderThickness="1" CornerRadius="6" MaxHeight="220"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DocumentViewModel">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   Style="{StaticResource CodeTextBlockStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="Failing sample" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView ItemsSource="{x:Bind Tab.Validation.Failing}" SelectionMode="None"
                                      BorderThickness="1" CornerRadius="6" MaxHeight="220"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DocumentViewModel">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   Style="{StaticResource CodeTextBlockStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
