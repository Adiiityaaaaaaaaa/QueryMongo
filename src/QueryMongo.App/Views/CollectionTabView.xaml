<UserControl
    x:Class="QueryMongo.App.Views.CollectionTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:panes="using:QueryMongo.App.Views.Panes">

    <Grid Background="{ThemeResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Collection header ===================== -->
        <!--
            Compass's collection header: the breadcrumb trail, then the badges that say
            what kind of collection this is, then the actions. Padded 16 at the sides,
            8 at the top and nothing at the bottom, so the sub-tabs sit right under it.
        -->
        <Grid Grid.Row="0" Padding="16,8,16,0" ColumnSpacing="8"
              Background="{ThemeResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <c:Breadcrumbs x:Name="Trail" Grid.Column="0" Margin="0,8" />

            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}"
                    Visibility="{x:Bind c:Converters.Visible(Tab.IsReadOnly), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:LeafyIcon Glyph="{x:Bind Tab.IconGlyph}" Size="12" />
                    <TextBlock Text="{x:Bind Tab.KindLabel}" FontSize="11" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Bind Tab.StatsSummary, Mode=OneWay}" />

                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnImport">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:LeafyIcon Glyph="Import" Size="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnExport">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:LeafyIcon Glyph="Export" Size="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarIconButtonStyle}"
                        Command="{x:Bind Tab.LoadStatsCommand}"
                        AutomationProperties.Name="Refresh stats"
                        ToolTipService.ToolTip="Refresh stats">
                    <c:LeafyIcon Glyph="Refresh" Size="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Sub-tabs ===================== -->
        <!--
            Compass underlines the selected sub-tab in green rather than filling it, and
            pads the row 16 at the sides so it lines up with the header above.
        -->
        <Border Grid.Row="1" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled" Padding="16,0">
                <StackPanel x:Name="PaneBar" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- ===================== Panes ===================== -->
        <Grid Grid.Row="2">
            <panes:DocumentsPane x:Name="Documents"
                                 Model="{x:Bind Tab.Documents}"
                                 ShowScanWarning="{x:Bind Tab.ShowCollectionScanWarning, Mode=OneWay}"
                                 ExplainRequested="OnExplainRequested"
                                 ImportRequested="OnImport"
                                 ExportRequested="OnExportRequested"
                                 Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 0), Mode=OneWay}" />

            <panes:AggregationPane Model="{x:Bind Tab.Aggregation}"
                                   Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 1), Mode=OneWay}" />

            <panes:SchemaPane Model="{x:Bind Tab.Schema}"
                              Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 2), Mode=OneWay}" />

            <panes:ExplainPane Model="{x:Bind Tab.Explain}" SpecSource="{x:Bind Tab.Documents}"
                               Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 3), Mode=OneWay}" />

            <panes:IndexesPane Model="{x:Bind Tab.Indexes}"
                               Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 4), Mode=OneWay}" />

            <panes:SearchIndexesPane Model="{x:Bind Tab.SearchIndexes}"
                                     Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 5), Mode=OneWay}" />

            <panes:ValidationPane Model="{x:Bind Tab.Validation}"
                                  Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 6), Mode=OneWay}" />

            <panes:MapPane Model="{x:Bind Tab.Map}"
                           Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 7), Mode=OneWay}" />

            <panes:ShellPane Model="{x:Bind Tab.MongoShell}"
                             Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 8), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
