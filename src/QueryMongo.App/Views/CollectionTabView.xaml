<UserControl
    x:Class="QueryMongo.App.Views.CollectionTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:panes="using:QueryMongo.App.Views.Panes">

    <Grid Background="{ThemeResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Collection header ===================== -->
        <Grid Grid.Row="0" Padding="20,12,20,8" ColumnSpacing="12"
              Background="{ThemeResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Tab.Database}" Style="{StaticResource PageTitleStyle}"
                               Foreground="{ThemeResource InkMutedBrush}" />
                    <TextBlock Text="." Style="{StaticResource PageTitleStyle}"
                               Foreground="{ThemeResource InkFaintBrush}" />
                    <TextBlock Text="{x:Bind Tab.Collection}" Style="{StaticResource PageTitleStyle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="{x:Bind Tab.StatsSummary, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Import" Style="{StaticResource SecondaryButtonStyle}" Click="OnImport" />
                <Button Content="Export" Style="{StaticResource SecondaryButtonStyle}" Click="OnExport" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind Tab.LoadStatsCommand}" ToolTipService.ToolTip="Refresh stats">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Tab strip ===================== -->
        <Border Grid.Row="1" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <SelectorBar x:Name="PaneBar" Margin="14,0,0,0" SelectionChanged="OnPaneChanged">
                    <SelectorBarItem Text="Documents" />
                    <SelectorBarItem Text="Aggregations" />
                    <SelectorBarItem Text="Schema" />
                    <SelectorBarItem Text="Explain Plan" />
                    <SelectorBarItem Text="Indexes" />
                    <SelectorBarItem Text="Search Indexes" />
                    <SelectorBarItem Text="Validation" />
                    <SelectorBarItem Text="Map" />
                    <SelectorBarItem Text="Shell" />
                </SelectorBar>
            </ScrollViewer>
        </Border>

        <!-- ===================== Panes ===================== -->
        <Grid Grid.Row="2">
            <panes:DocumentsPane Model="{x:Bind Tab.Documents}"
                                 ShowScanWarning="{x:Bind Tab.ShowCollectionScanWarning, Mode=OneWay}"
                                 Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 0), Mode=OneWay}" />

            <panes:AggregationPane Model="{x:Bind Tab.Aggregation}"
                                   Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 1), Mode=OneWay}" />

            <panes:SchemaPane Model="{x:Bind Tab.Schema}"
                              Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 2), Mode=OneWay}" />

            <panes:ExplainPane Model="{x:Bind Tab.Explain}" SpecSource="{x:Bind Tab.Documents}"
                               Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 3), Mode=OneWay}" />

            <panes:IndexesPane Model="{x:Bind Tab.Indexes}"
                               Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 4), Mode=OneWay}" />

            <panes:SearchIndexesPane Model="{x:Bind Tab.SearchIndexes}"
                                     Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 5), Mode=OneWay}" />

            <panes:ValidationPane Model="{x:Bind Tab.Validation}"
                                  Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 6), Mode=OneWay}" />

            <panes:MapPane Model="{x:Bind Tab.Map}"
                           Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 7), Mode=OneWay}" />

            <panes:ShellPane Model="{x:Bind Tab.MongoShell}"
                             Visibility="{x:Bind c:Converters.VisibleWhen(Tab.SelectedPane, 8), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
