<UserControl
    x:Class="QueryMongo.App.Views.Workspaces.CollectionsWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels">

    <!--
        The collection list Compass opens when a database is clicked. The columns are the
        ones Compass shows, in the same order, including the property badges.
    -->
    <Grid Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,8,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <c:Breadcrumbs x:Name="Trail" Grid.Column="0" Margin="0,8" />

            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenShell">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Shell" Size="14" />
                    <TextBlock Text="Open MongoDB shell" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{x:Bind Model.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Refresh" Size="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Click="OnCreateCollection">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Plus" Size="14" />
                    <TextBlock Text="Create collection" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Margin="16,0,16,8" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                 Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" Margin="16,0" Padding="12,6"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Collection name" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="Properties" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="Storage size" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="Data size" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Documents" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Avg. document size" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="6" Text="Indexes" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="7" Text="Total index size" Style="{StaticResource ColumnHeaderStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer Padding="16,0,16,16" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                <ItemsControl ItemsSource="{x:Bind Model.Collections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionRowViewModel">
                            <Grid MinHeight="36" Padding="12,0" Tag="{x:Bind}"
                                  PointerEntered="OnRowPointerEntered"
                                  PointerExited="OnRowPointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="RowFill" Grid.ColumnSpan="9" Margin="-12,0"
                                        Background="{ThemeResource RowHoverBrush}" Opacity="0" />

                                <HyperlinkButton Grid.Column="0" Padding="0" Tag="{x:Bind}"
                                                 Click="OnOpenCollection"
                                                 Content="{x:Bind Name}" />

                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Badges}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CollectionBadgeViewModel">
                                            <Border Style="{StaticResource BadgeStyle}"
                                                    ToolTipService.ToolTip="{x:Bind Hint}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <c:LeafyIcon Glyph="{x:Bind Glyph}" Size="12"
                                                                 Visibility="{x:Bind c:Converters.Visible(HasGlyph)}" />
                                                    <TextBlock Text="{x:Bind Label}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="2" Text="{x:Bind StorageSize}"
                                           Style="{StaticResource TableCellStyle}"
                                           ToolTipService.ToolTip="{x:Bind StorageTooltip}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DataSize}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Documents}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind AverageDocumentSize}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Indexes}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind IndexSize}" Style="{StaticResource TableCellStyle}" />

                                <Button x:Name="RowActions" Grid.Column="8"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        Opacity="0" Tag="{x:Bind}" Click="OnDropCollection"
                                        AutomationProperties.Name="Drop collection"
                                        ToolTipService.ToolTip="Drop collection">
                                    <c:LeafyIcon Glyph="Trash" Size="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}"
                          Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

            <TextBlock Text="No collections in this database." Margin="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource InkFaintBrush}"
                       Visibility="{x:Bind c:Converters.Visible(Model.IsEmpty), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
