<UserControl
    x:Class="QueryMongo.App.Views.Workspaces.WelcomeWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls">

    <!--
        Compass centres a picture and a short column of text, with the Atlas panel
        underneath. The wording here is ours, but the shape is the same.
    -->
    <ScrollViewer Background="{ThemeResource SurfaceBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24">

            <Viewbox Width="220" Height="220" Margin="0,0,24,0" Opacity="0.85">
                <c:LeafyIcon Glyph="Cap" Size="16" Foreground="{ThemeResource AccentGreenBrush}" />
            </Viewbox>

            <StackPanel MaxWidth="450" Spacing="8">
                <TextBlock Text="Welcome to QueryMongo"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource InkStrongBrush}" />

                <TextBlock Text="To get started, connect to an existing server."
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource InkBrush}" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,8"
                        Click="OnAddConnection">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:LeafyIcon Glyph="Plus" Size="14" />
                        <TextBlock Text="Add new connection" />
                    </StackPanel>
                </Button>

                <!-- Atlas panel: green.light3 on green.light2, radius 8, padding 24 -->
                <Border CornerRadius="8" Padding="24"
                        Background="{ThemeResource AccentSoftBrush}"
                        BorderBrush="{ThemeResource AccentGreenBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="No cluster yet?"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource InkStrongBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="You can create one for free with MongoDB Atlas, then paste its connection string here." />
                        <HyperlinkButton Content="Open MongoDB Atlas"
                                         Padding="0" Margin="0,4,0,0"
                                         NavigateUri="https://www.mongodb.com/cloud/atlas/lp/try4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
