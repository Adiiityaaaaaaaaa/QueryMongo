<UserControl
    x:Class="QueryMongo.App.Views.Workspaces.DatabasesWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels">

    <!--
        The database list Compass opens when a connection is clicked: a breadcrumb and a
        toolbar above a table of every database with the counters from dbStats.
    -->
    <Grid Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Breadcrumb and actions -->
        <Grid Grid.Row="0" Padding="16,8,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <c:Breadcrumbs x:Name="Trail" Grid.Column="0" Margin="0,8" />

            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenShell">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Shell" Size="14" />
                    <TextBlock Text="Open MongoDB shell" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{x:Bind Model.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Refresh" Size="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Click="OnCreateDatabase">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LeafyIcon Glyph="Plus" Size="14" />
                    <TextBlock Text="Create database" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Margin="16,0,16,8" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                 Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />

        <!-- Column headings -->
        <Grid Grid.Row="2" Margin="16,0" Padding="12,6"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Database name" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="Storage size" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="Data size" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="Collections" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Indexes" Style="{StaticResource ColumnHeaderStyle}" />
        </Grid>

        <!-- Rows -->
        <Grid Grid.Row="3">
            <ScrollViewer Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Model.Databases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DatabaseRowViewModel">
                            <Grid Height="36" Padding="12,0" Tag="{x:Bind}"
                                  PointerEntered="OnRowPointerEntered"
                                  PointerExited="OnRowPointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="RowFill" Grid.ColumnSpan="6" Margin="-12,0"
                                        Background="{ThemeResource RowHoverBrush}" Opacity="0" />

                                <HyperlinkButton Grid.Column="0" Padding="0" Tag="{x:Bind}"
                                                 Click="OnOpenDatabase"
                                                 Content="{x:Bind Name}" />

                                <TextBlock Grid.Column="1" Text="{x:Bind StorageSize}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DataSize}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Collections}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Indexes}" Style="{StaticResource TableCellStyle}" />

                                <Button x:Name="RowActions" Grid.Column="5"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        Opacity="0" Tag="{x:Bind}" Click="OnDropDatabase"
                                        AutomationProperties.Name="Drop database"
                                        ToolTipService.ToolTip="Drop database">
                                    <c:LeafyIcon Glyph="Trash" Size="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}"
                          Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

            <TextBlock Text="No databases." Margin="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource InkFaintBrush}"
                       Visibility="{x:Bind c:Converters.Visible(Model.IsEmpty), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
