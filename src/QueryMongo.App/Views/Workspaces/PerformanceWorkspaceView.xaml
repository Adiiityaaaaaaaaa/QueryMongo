<UserControl
    x:Class="QueryMongo.App.Views.Workspaces.PerformanceWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:svc="using:QueryMongo.Core.Services">

    <ScrollViewer Padding="24,16,24,24" Background="{ThemeResource SurfaceBrush}">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Performance" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="{x:Bind Model.Status, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Start / pause"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind Model.ToggleCommand}" />
                <Button Grid.Column="2" Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind Model.SampleCommand}" />
            </Grid>

            <InfoBar Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                     Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="Inserts/sec" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{x:Bind Model.InsertRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="Queries/sec" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{x:Bind Model.QueryRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="Updates/sec" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{x:Bind Model.UpdateRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="Deletes/sec" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{x:Bind Model.DeleteRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="Commands/sec" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{x:Bind Model.CommandRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connections"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                               Text="{x:Bind Model.Connections, Mode=OneWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                               Text="{x:Bind Model.Memory, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Network"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock FontSize="12"
                                   Text="{x:Bind Model.NetworkIn, Mode=OneWay}" />
                        <TextBlock FontSize="12"
                                   Text="{x:Bind Model.NetworkOut, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Uptime"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12"
                               Text="{x:Bind Model.Uptime, Mode=OneWay}" />
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CURRENT OPERATIONS" VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <CheckBox Grid.Column="1" Content="Include idle" FontSize="12"
                              IsChecked="{x:Bind Model.ShowIdleOperations, Mode=TwoWay}" />
                </Grid>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <ListView ItemsSource="{x:Bind Model.Operations}" SelectionMode="None"
                              MaxHeight="320">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:CurrentOperation">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Type}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Namespace}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource CodeFontFamily}" />
                                    <TextBlock Grid.Column="2" FontSize="12"
                                               Text="{x:Bind SecondsRunning}" />
                                    <Button Grid.Column="3" Content="Kill" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}" Padding="10,2"
                                            Tag="{x:Bind}" Click="OnKillOperation" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
