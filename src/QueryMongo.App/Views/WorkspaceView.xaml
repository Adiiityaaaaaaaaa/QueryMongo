<UserControl
    x:Class="QueryMongo.App.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels">

    <!--
        The window is laid out the way Compass lays it out: a resizable sidebar on the
        left, and to its right a workspace column whose tab strip sits above the active
        workspace's content. The strip belongs to the workspace column, not to the
        window, so it never runs across the sidebar.
    -->
    <Grid Background="{ThemeResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Grid x:Name="Sidebar"
              Grid.Column="0"
              Width="300"
              MinWidth="210"
              MaxWidth="600"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title row: the app name, and settings on the right -->
            <Grid Grid.Row="0" Padding="16,16,16,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="QueryMongo"
                           FontSize="18" FontWeight="SemiBold" LineHeight="32"
                           Foreground="{ThemeResource SidebarTextBrush}" />

                <Button Grid.Column="1" Style="{StaticResource SidebarIconButtonStyle}"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings"
                        Click="OnOpenSettings">
                    <c:LeafyIcon Glyph="Settings" Size="14" />
                </Button>
            </Grid>

            <!-- Global navigation, above the connection list -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Button Style="{StaticResource SidebarNavItemStyle}" Click="OnOpenMyQueries">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:LeafyIcon Glyph="CurlyBraces" Size="14" />
                        <TextBlock Text="My Queries" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="2" Height="1" Margin="0,8"
                    Background="{ThemeResource HairlineBrush}" />

            <!-- Connection list header -->
            <Grid Grid.Row="3" Padding="16,0" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="CONNECTIONS" FontSize="12" LineHeight="32"
                               Foreground="{ThemeResource SidebarTextBrush}" />
                    <TextBlock Text="{x:Bind Shell.ConnectionCountLabel, Mode=OneWay}"
                               FontSize="12" LineHeight="32"
                               Foreground="{ThemeResource SidebarMutedBrush}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SidebarIconButtonStyle}"
                        AutomationProperties.Name="Collapse all connections"
                        ToolTipService.ToolTip="Collapse all connections"
                        Command="{x:Bind Shell.CollapseAllConnectionsCommand}">
                    <c:LeafyIcon Glyph="CollapseVertical" Size="14" />
                </Button>

                <Button Grid.Column="2" Style="{StaticResource SidebarIconButtonStyle}"
                        AutomationProperties.Name="Add new connection"
                        ToolTipService.ToolTip="Add new connection"
                        Click="OnNewConnection">
                    <c:LeafyIcon Glyph="Plus" Size="14" />
                </Button>
            </Grid>

            <!-- Filter -->
            <TextBox Grid.Row="4" Margin="16,0,16,8"
                     PlaceholderText="Search"
                     FontSize="13"
                     Text="{x:Bind Shell.SidebarFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Tree -->
            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Padding="0,0,0,16">
                <StackPanel>

                    <!-- Nothing saved yet -->
                    <StackPanel Padding="16,8" Spacing="8"
                                Visibility="{x:Bind c:Converters.Hidden(Shell.HasConnections), Mode=OneWay}">
                        <TextBlock Text="You have not connected to a deployment yet."
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SidebarMutedBrush}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Content="Add new connection"
                                Click="OnNewConnection" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind Shell.Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionViewModel">
                                <StackPanel>

                                    <!-- Connection row -->
                                    <Grid Height="28"
                                          Background="{x:Bind c:Converters.ConnectionColor(ColorCode), Mode=OneWay}"
                                          Tag="{x:Bind}"
                                          PointerEntered="OnRowPointerEntered"
                                          PointerExited="OnRowPointerExited"
                                          RightTapped="OnConnectionActions">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Hover fill, drawn under the content -->
                                        <Border x:Name="RowFill" Grid.ColumnSpan="3"
                                                Background="{ThemeResource SidebarItemHoverBrush}"
                                                Opacity="0" />

                                        <!-- Caret. 16px wide, so every level lands on the same grid. -->
                                        <Button Grid.Column="0" Margin="16,0,0,0"
                                                Style="{StaticResource TreeCaretStyle}"
                                                Tag="{x:Bind}"
                                                IsEnabled="{x:Bind CanExpand, Mode=OneWay}"
                                                Click="OnToggleConnection">
                                            <c:LeafyIcon Glyph="{x:Bind CaretGlyph, Mode=OneWay}" Size="14" />
                                        </Button>

                                        <!-- Icon with its status badge, then the name -->
                                        <Button Grid.Column="1"
                                                Style="{StaticResource TreeRowButtonStyle}"
                                                Tag="{x:Bind}"
                                                Click="OnConnectionClick"
                                                ToolTipService.ToolTip="{x:Bind RedactedUri, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="16" Height="16">
                                                    <c:LeafyIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" Size="16" />
                                                    <c:StatusMarker Status="{x:Bind StatusMarker, Mode=OneWay}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Row actions, revealed on hover -->
                                        <Button x:Name="RowActions" Grid.Column="2" Margin="0,0,16,0"
                                                Style="{StaticResource SidebarIconButtonStyle}"
                                                Opacity="0" Tag="{x:Bind}"
                                                Click="OnConnectionActions">
                                            <c:LeafyIcon Glyph="Ellipsis" Size="14" />
                                        </Button>
                                    </Grid>

                                    <!-- Databases -->
                                    <ItemsControl ItemsSource="{x:Bind Databases}"
                                                  Visibility="{x:Bind c:Converters.Visible(IsExpanded), Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DatabaseNodeViewModel">
                                                <StackPanel>

                                                    <!-- Database row: 16 base plus one caret slot -->
                                                    <Grid Height="28"
                                                          Tag="{x:Bind}"
                                                          PointerEntered="OnRowPointerEntered"
                                                          PointerExited="OnRowPointerExited"
                                                          RightTapped="OnDatabaseActions">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border x:Name="RowFill" Grid.ColumnSpan="3"
                                                                Background="{ThemeResource SidebarItemHoverBrush}"
                                                                Opacity="0" />

                                                        <Button Grid.Column="0" Margin="34,0,0,0"
                                                                Style="{StaticResource TreeCaretStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="OnToggleDatabase">
                                                            <c:LeafyIcon Glyph="{x:Bind CaretGlyph, Mode=OneWay}" Size="14" />
                                                        </Button>

                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource TreeRowButtonStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="OnDatabaseClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <c:LeafyIcon Glyph="{x:Bind IconGlyph}" Size="16" />
                                                                <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button x:Name="RowActions" Grid.Column="2" Margin="0,0,16,0"
                                                                Style="{StaticResource SidebarIconButtonStyle}"
                                                                Opacity="0" Tag="{x:Bind}"
                                                                Click="OnDatabaseActions">
                                                            <c:LeafyIcon Glyph="Ellipsis" Size="14" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Collections: 16 base plus two caret slots -->
                                                    <ItemsControl ItemsSource="{x:Bind Collections}"
                                                                  Visibility="{x:Bind c:Converters.Visible(IsExpanded), Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CollectionNodeViewModel">
                                                                <Grid Height="28"
                                                                      Tag="{x:Bind}"
                                                                      PointerEntered="OnRowPointerEntered"
                                                                      PointerExited="OnRowPointerExited"
                                                                      RightTapped="OnCollectionActions">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border x:Name="RowFill" Grid.ColumnSpan="2"
                                                                            Background="{ThemeResource SidebarItemHoverBrush}"
                                                                            Opacity="0" />

                                                                    <Button Grid.Column="0" Margin="70,0,0,0"
                                                                            Style="{StaticResource TreeRowButtonStyle}"
                                                                            Tag="{x:Bind}"
                                                                            Click="OnCollectionClick"
                                                                            ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <c:LeafyIcon Glyph="{x:Bind IconGlyph}" Size="16" />
                                                                            <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <Button x:Name="RowActions" Grid.Column="1" Margin="0,0,16,0"
                                                                            Style="{StaticResource SidebarIconButtonStyle}"
                                                                            Opacity="0" Tag="{x:Bind}"
                                                                            Click="OnCollectionActions">
                                                                        <c:LeafyIcon Glyph="Ellipsis" Size="14" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Drag handle, over the right edge of the sidebar -->
            <Border Grid.Row="0" Grid.RowSpan="6"
                    Width="4" HorizontalAlignment="Right"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    ManipulationDelta="OnSidebarResize"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited" />
        </Grid>

        <!-- ======================= Workspace ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tab strip -->
            <Grid Grid.Row="0" MinHeight="36"
                  Background="{ThemeResource TabStripBackgroundBrush}"
                  BorderBrush="{ThemeResource TabBorderBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto">
                    <ItemsControl ItemsSource="{x:Bind Shell.Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                <c:WorkspaceTabItem Tab="{x:Bind}"
                                                    Selected="OnTabSelected"
                                                    CloseRequested="OnTabClosed"
                                                    CloseOthersRequested="OnTabCloseOthers" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" Margin="4"
                        Style="{StaticResource SidebarIconButtonStyle}"
                        AutomationProperties.Name="New tab"
                        ToolTipService.ToolTip="New tab"
                        Click="OnNewTab">
                    <c:LeafyIcon Glyph="Plus" Size="14" />
                </Button>
            </Grid>

            <!-- Active workspace -->
            <Grid Grid.Row="1" Background="{ThemeResource SurfaceBrush}">
                <ContentControl x:Name="WorkspaceHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind Shell.ActiveTab, Mode=OneWay}"
                                />

                <!-- Nothing open: Compass shows a faint logo mark -->
                <Viewbox Width="160" Height="160" Opacity="0.05"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{x:Bind c:Converters.Hidden(Shell.HasActiveTab), Mode=OneWay}">
                    <c:LeafyIcon Glyph="Cap" Size="16"
                                 Foreground="{ThemeResource InkBrush}" />
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
