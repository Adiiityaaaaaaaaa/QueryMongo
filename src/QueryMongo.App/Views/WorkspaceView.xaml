<UserControl
    x:Class="QueryMongo.App.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels"
    xmlns:svc="using:QueryMongo.Core.Services"
    xmlns:local="using:QueryMongo.App.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,8,8,4" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Databases" VerticalAlignment="Center"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Button Grid.Column="1" Click="OnCreateDatabase" Padding="6,2"
                        ToolTipService.ToolTip="Create database">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                </Button>
                <Button Grid.Column="2" Command="{x:Bind Shell.RefreshDatabasesCommand}" Padding="6,2"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>

            <AutoSuggestBox Grid.Row="1" Margin="12,4,12,8" QueryIcon="Find"
                            PlaceholderText="Filter databases and collections"
                            Text="{x:Bind Shell.SidebarFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="4,0,4,8">
                <ItemsControl ItemsSource="{x:Bind Shell.Databases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DatabaseNodeViewModel">
                            <Expander HorizontalAlignment="Stretch" Margin="0,1" Padding="0"
                                      Background="Transparent" BorderThickness="0"
                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="8" Padding="0,2">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Create collection" Tag="{x:Bind}"
                                                                Click="OnCreateCollection">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE710;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Drop database" Tag="{x:Bind}"
                                                                Click="OnDropDatabase">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeDescription}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="20,0,0,4">
                                    <ProgressBar IsIndeterminate="True" Margin="4"
                                                 Visibility="{x:Bind c:Converters.Visible(IsLoading), Mode=OneWay}" />

                                    <ItemsControl ItemsSource="{x:Bind Collections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CollectionNodeViewModel">
                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8,5" Tag="{x:Bind}"
                                                        Click="OnCollectionClick">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open" Tag="{x:Bind}"
                                                                            Click="OnCollectionClick" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Rename collection" Tag="{x:Bind}"
                                                                            Click="OnRenameCollection" />
                                                            <MenuFlyoutItem Text="Delete all documents" Tag="{x:Bind}"
                                                                            Click="OnClearCollection" />
                                                            <MenuFlyoutItem Text="Drop collection" Tag="{x:Bind}"
                                                                            Click="OnDropCollection">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>

                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind KindLabel}" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="12" Spacing="6">
                <Button HorizontalAlignment="Stretch" Command="{x:Bind Shell.ShowPerformanceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                        <TextBlock Text="Performance" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" Content="Disconnect"
                        Command="{x:Bind Shell.DisconnectCommand}" />
            </StackPanel>
        </Grid>

        <!-- ========================== Main area ========================== -->
        <Grid Grid.Column="1">

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind c:Converters.Visible(ShowEmptyState), Mode=OneWay}">
                <FontIcon Glyph="&#xE8A4;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Pick a collection to start querying"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Collection tabs -->
            <TabView x:Name="Tabs" IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent"
                     TabItemsSource="{x:Bind Shell.Tabs}"
                     SelectedItem="{x:Bind Shell.ActiveTab, Mode=TwoWay}"
                     TabCloseRequested="OnTabCloseRequested"
                     Visibility="{x:Bind c:Converters.Visible(ShowTabs), Mode=OneWay}">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionTabViewModel">
                        <TabViewItem Header="{x:Bind Collection}"
                                     ToolTipService.ToolTip="{x:Bind Namespace}">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE8A4;" />
                            </TabViewItem.IconSource>
                            <local:CollectionTabView Tab="{x:Bind}" />
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <!-- Performance -->
            <ScrollViewer Padding="20,12,20,20"
                          Visibility="{x:Bind c:Converters.Visible(Shell.IsPerformanceOpen), Mode=OneWay}">
                <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Performance" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Shell.Performance.Status, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Start / pause"
                                Command="{x:Bind Shell.Performance.ToggleCommand}" />
                        <Button Grid.Column="2" Content="Back to collections"
                                Command="{x:Bind Shell.ShowCollectionsCommand}" />
                    </Grid>

                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind c:Converters.HasText(Shell.Performance.ErrorMessage), Mode=OneWay}"
                             Message="{x:Bind Shell.Performance.ErrorMessage, Mode=OneWay}" />

                    <!-- Operation rates -->
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Inserts/sec" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Style="{StaticResource StatValueStyle}"
                                           Text="{x:Bind Shell.Performance.InsertRateText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Queries/sec" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Style="{StaticResource StatValueStyle}"
                                           Text="{x:Bind Shell.Performance.QueryRateText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Updates/sec" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Style="{StaticResource StatValueStyle}"
                                           Text="{x:Bind Shell.Performance.UpdateRateText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Deletes/sec" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Style="{StaticResource StatValueStyle}"
                                           Text="{x:Bind Shell.Performance.DeleteRateText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="Commands/sec" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Style="{StaticResource StatValueStyle}"
                                           Text="{x:Bind Shell.Performance.CommandRateText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </ItemsControl>

                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Connections"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind Shell.Performance.Connections, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind Shell.Performance.Memory, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Network"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind Shell.Performance.NetworkIn, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Shell.Performance.NetworkOut, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Uptime"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Bind Shell.Performance.Uptime, Mode=OneWay}" />
                    </Grid>

                    <!-- Current operations -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Current operations"
                                       Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="Include idle" FontSize="12"
                                      IsChecked="{x:Bind Shell.Performance.ShowIdleOperations, Mode=TwoWay}" />
                        </Grid>

                        <ListView ItemsSource="{x:Bind Shell.Performance.Operations}" SelectionMode="None"
                                  MaxHeight="320" BorderThickness="1" CornerRadius="6"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:CurrentOperation">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Type}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Namespace}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" FontSize="12"
                                                   Text="{x:Bind SecondsRunning}" />
                                        <Button Grid.Column="3" Content="Kill" FontSize="11" Padding="8,2"
                                                Tag="{x:Bind}" Click="OnKillOperation" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
