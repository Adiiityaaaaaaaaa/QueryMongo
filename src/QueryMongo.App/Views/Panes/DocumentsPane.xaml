<UserControl
    x:Class="QueryMongo.App.Views.Panes.DocumentsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels"
    xmlns:conn="using:QueryMongo.Core.Connections">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Query bar ===================== -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Spacing="8">

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                        <TextBlock Text="Filter" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource InkMutedBrush}" />
                    </Border>

                    <TextBox Grid.Column="1" Style="{StaticResource CodeTextBoxStyle}"
                             PlaceholderText="{}{ field: value }"
                             Text="{x:Bind Model.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnFilterKeyDown" />

                    <Button Grid.Column="2" Content="Find" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind Model.RunQueryCommand}" />

                    <Button Grid.Column="3" Content="Reset" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind Model.ResetQueryCommand}" />

                    <ToggleButton Grid.Column="4" Padding="7,5"
                                  IsChecked="{x:Bind Model.IsQueryBarExpanded, Mode=TwoWay}"
                                  ToolTipService.ToolTip="More query options">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </ToggleButton>

                    <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Query history and favourites">
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="480" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RECENT AND SAVED"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource SectionHeaderStyle}" />
                                        <Button Grid.Column="1" Content="Save current" FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OnSaveFavorite" />
                                        <Button Grid.Column="2" Content="Clear" FontSize="12" Margin="6,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{x:Bind Model.ClearHistoryCommand}" />
                                    </Grid>

                                    <ListView ItemsSource="{x:Bind Model.History}" SelectionMode="None"
                                              MaxHeight="340">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="conn:SavedQuery">
                                                <Grid ColumnSpacing="8" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="5"
                                                                    Visibility="{x:Bind c:Converters.NotEmpty(Name)}">
                                                            <FontIcon Glyph="&#xE735;" FontSize="11"
                                                                      Foreground="{ThemeResource AccentGreenBrush}" />
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Summary}"
                                                                   Style="{StaticResource CodeTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   Foreground="{ThemeResource InkMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Use" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,2" Tag="{x:Bind}" Click="OnUseSavedQuery" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                                            Tag="{x:Bind}" Click="OnDeleteSavedQuery">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE10C;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Insert document" Click="OnInsertDocument">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Update matching documents" Click="OnUpdateMany" />
                                <MenuFlyoutItem Text="Delete matching documents" Click="OnDeleteMany">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Export query to language" Click="OnExportQuery" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Expand all" Command="{x:Bind Model.ExpandAllCommand}" />
                                <MenuFlyoutItem Text="Collapse all" Command="{x:Bind Model.CollapseAllCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="8" RowSpacing="8"
                      Visibility="{x:Bind c:Converters.Visible(Model.IsQueryBarExpanded), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Header="Project"
                             Style="{StaticResource CodeTextBoxStyle}"
                             PlaceholderText="{}{ field: 1 }"
                             Text="{x:Bind Model.Projection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Header="Sort"
                             Style="{StaticResource CodeTextBoxStyle}"
                             PlaceholderText="{}{ field: -1 }"
                             Text="{x:Bind Model.Sort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox Grid.Row="0" Grid.Column="2" Header="Limit" Minimum="1" Maximum="1000"
                               Width="100" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Model.Limit, Mode=TwoWay}" />
                    <NumberBox Grid.Row="0" Grid.Column="3" Header="Skip" Minimum="0"
                               Width="100" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Model.Skip, Mode=TwoWay}" />

                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Collation"
                             Style="{StaticResource CodeTextBoxStyle}"
                             PlaceholderText="{}{ locale: 'en' }"
                             Text="{x:Bind Model.Collation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Status strip ===================== -->
        <StackPanel Grid.Row="1" Spacing="6" Padding="20,8,20,4">
            <InfoBar Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                     Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />

            <InfoBar Severity="Success" IsClosable="True"
                     IsOpen="{x:Bind c:Converters.HasText(Model.StatusMessage), Mode=OneWay}"
                     Message="{x:Bind Model.StatusMessage, Mode=OneWay}" />

            <InfoBar Severity="Warning" IsClosable="False" Title="Collection scan"
                     IsOpen="{x:Bind ShowScanWarning, Mode=OneWay}"
                     Message="This query has no usable index, so the server reads every document. Add an index on the filtered fields." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- View mode switcher -->
                <Border Grid.Column="0" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource HairlineBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ListButton" Click="OnShowList" Padding="10,5"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="List view">
                            <FontIcon Glyph="&#xE8A4;" FontSize="14" />
                        </Button>
                        <Button x:Name="TableButton" Click="OnShowTable" Padding="10,5"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Table view">
                            <FontIcon Glyph="&#xE80A;" FontSize="14" />
                        </Button>
                        <Button x:Name="JsonButton" Click="OnShowJson" Padding="10,5"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="JSON view">
                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{x:Bind Model.ResultSummary, Mode=OneWay}" />

                <ProgressRing Grid.Column="2" IsActive="{x:Bind Model.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" />
            </Grid>
        </StackPanel>

        <!-- ===================== Results ===================== -->
        <Grid Grid.Row="2" Background="{ThemeResource CanvasBrush}">

            <!-- List view: one card per document -->
            <ScrollViewer Padding="20,12,20,0"
                          Visibility="{x:Bind c:Converters.Visible(Model.IsListMode), Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind Model.Documents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModel">
                            <Border Style="{StaticResource DocumentCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Card header -->
                                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                                                Tag="{x:Bind}" Click="OnToggleExpand" Padding="4">
                                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                        </Button>

                                        <TextBlock Grid.Column="1" Text="{x:Bind IdDescription}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource CodeFontFamily}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}"
                                                    Click="OnEditDocument" ToolTipService.ToolTip="Edit">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}"
                                                    Click="OnCopyDocument" ToolTipService.ToolTip="Copy JSON">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}"
                                                    Click="OnCloneDocument" ToolTipService.ToolTip="Clone">
                                                <FontIcon Glyph="&#xF413;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}"
                                                    Click="OnDeleteDocument" ToolTipService.ToolTip="Delete">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"
                                                          Foreground="{ThemeResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed preview -->
                                    <TextBlock Grid.Row="1" Margin="12,0,12,10"
                                               Style="{StaticResource CodeTextBlockStyle}"
                                               c:JsonHighlight.Json="{x:Bind Preview}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind c:Converters.Hidden(IsExpanded), Mode=OneWay}" />

                                    <!-- Expanded body -->
                                    <StackPanel Grid.Row="1" Margin="12,0,12,10" Spacing="8"
                                                Visibility="{x:Bind c:Converters.Visible(IsExpanded), Mode=OneWay}">

                                        <TextBlock Style="{StaticResource CodeTextBlockStyle}"
                                                   c:JsonHighlight.Json="{x:Bind Json}"
                                                   Visibility="{x:Bind c:Converters.Visible(IsReadOnly), Mode=OneWay}" />

                                        <StackPanel Spacing="8"
                                                    Visibility="{x:Bind c:Converters.Visible(IsEditing), Mode=OneWay}">
                                            <TextBox Style="{StaticResource CodeEditorStyle}" MinHeight="180"
                                                     Text="{x:Bind EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <InfoBar Severity="Error" IsClosable="False"
                                                     IsOpen="{x:Bind c:Converters.HasText(EditError), Mode=OneWay}"
                                                     Message="{x:Bind EditError, Mode=OneWay}" />

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Update" Style="{StaticResource PrimaryButtonStyle}"
                                                        Tag="{x:Bind}" Click="OnSaveDocument" />
                                                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{x:Bind}" Click="OnCancelEdit" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Table view -->
            <Grid Visibility="{x:Bind c:Converters.Visible(Model.IsTableMode), Mode=OneWay}"
                  Background="{ThemeResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="HeaderScroll" Grid.Row="0" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Background="{ThemeResource CanvasBrush}">
                    <ItemsControl ItemsSource="{x:Bind Model.Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Width="190" Padding="10,7" BorderThickness="0,0,1,1"
                                        BorderBrush="{ThemeResource HairlineBrush}">
                                    <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto" ViewChanged="OnTableScrolled">
                    <ItemsControl ItemsSource="{x:Bind Model.Documents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentViewModel">
                                <ItemsControl ItemsSource="{x:Bind Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DocumentCell">
                                            <Border Width="190" Padding="10,6" BorderThickness="0,0,1,1"
                                                    BorderBrush="{ThemeResource HairlineBrush}">
                                                <TextBlock Text="{x:Bind Value}" FontSize="12"
                                                           FontFamily="{StaticResource CodeFontFamily}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- JSON view -->
            <ScrollViewer Padding="20,12,20,0" Background="{ThemeResource SurfaceBrush}"
                          HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          Visibility="{x:Bind c:Converters.Visible(Model.IsJsonMode), Mode=OneWay}">
                <TextBlock Style="{StaticResource CodeTextBlockStyle}" TextWrapping="NoWrap"
                           c:JsonHighlight.Json="{x:Bind Model.RawJson, Mode=OneWay}" />
            </ScrollViewer>
        </Grid>

        <!-- ===================== Paging ===================== -->
        <Border Grid.Row="3" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind Model.PreviousPageCommand}"
                        IsEnabled="{x:Bind Model.CanGoBack, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        <TextBlock Text="Previous" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind Model.NextPageCommand}"
                        IsEnabled="{x:Bind Model.HasMore, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Next" />
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
