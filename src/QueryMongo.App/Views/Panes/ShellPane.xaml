<UserControl
    x:Class="QueryMongo.App.Views.Panes.ShellPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels">

    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="16,8" ColumnSpacing="10"
              Background="{ThemeResource ShellBackgroundBrush}"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource ShellMutedBrush}"
                       Text="Commands run through the driver. There is no JavaScript engine." />

            <Button Grid.Column="1" Content="Help" FontSize="12" Padding="10,4"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{ThemeResource ShellMutedBrush}"
                    Foreground="{ThemeResource ShellTextBrush}"
                    Command="{x:Bind Model.ShowHelpCommand}" />

            <Button Grid.Column="2" Content="Clear" FontSize="12" Padding="10,4"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{ThemeResource ShellMutedBrush}"
                    Foreground="{ThemeResource ShellTextBrush}"
                    Command="{x:Bind Model.ClearCommand}" />
        </Grid>

        <!-- Transcript -->
        <ScrollViewer x:Name="Transcript" Grid.Row="1" Padding="16,12"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Model.Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShellEntry">
                        <StackPanel Margin="0,0,0,10" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind c:Converters.NotEmpty(Command)}">
                                <TextBlock Text="{x:Bind Prompt}" FontSize="12"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           Foreground="{ThemeResource ShellPromptBrush}" />
                                <TextBlock Text="{x:Bind Command}" FontSize="12"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                           Foreground="{ThemeResource ShellTextBrush}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind Output}" FontSize="12"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Visibility="{x:Bind c:Converters.Visible(HasOutput)}"
                                       Foreground="{ThemeResource ShellMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Prompt -->
        <Grid Grid.Row="2" Padding="16,10" ColumnSpacing="10"
              BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                       FontFamily="{StaticResource CodeFontFamily}"
                       Foreground="{ThemeResource ShellPromptBrush}"
                       Text="{x:Bind Model.Prompt, Mode=OneWay}" />

            <TextBox x:Name="InputBox" Grid.Column="1" FontSize="13"
                     FontFamily="{StaticResource CodeFontFamily}"
                     PlaceholderText="db.collection.find({ })"
                     IsSpellCheckEnabled="False"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{ThemeResource ShellTextBrush}"
                     Text="{x:Bind Model.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnInputKeyDown" />

            <ProgressRing Grid.Column="2" Width="16" Height="16"
                          IsActive="{x:Bind Model.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
