<UserControl
    x:Class="QueryMongo.App.Views.Panes.MapPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Header="Coordinate field" MinWidth="190"
                              ItemsSource="{x:Bind Model.CandidateFields}"
                              SelectedItem="{x:Bind Model.SelectedField, Mode=TwoWay}" />

                    <TextBox Grid.Column="1" Header="Label field" Width="150"
                             PlaceholderText="_id"
                             Text="{x:Bind Model.LabelField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Column="2" Header="Filter" Style="{StaticResource CodeTextBoxStyle}"
                             PlaceholderText="{}{ }"
                             Text="{x:Bind Model.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="3" Content="Plot" VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind Model.LoadCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="{x:Bind Model.Summary, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind Model.IsBusy, Mode=OneWay}" Width="14" Height="14" />
                </StackPanel>

                <InfoBar Severity="Error" IsClosable="False"
                         IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                         Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />

                <InfoBar Severity="Informational" IsClosable="False" Title="No coordinate data"
                         IsOpen="{x:Bind c:Converters.Not(Model.HasGeoData), Mode=OneWay}"
                         Message="No GeoJSON points or [longitude, latitude] pairs were found in a sample of this collection." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="20,14" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource HairlineBrush}"
                Background="{ThemeResource SurfaceBrush}">
            <Grid>
                <c:GeoMap x:Name="Map" />

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Visibility="{x:Bind c:Converters.Hidden(Model.HasPoints), Mode=OneWay}"
                           Text="Nothing plotted yet." />

                <!-- Projection note, so the view is not mistaken for a real map -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        CornerRadius="3" Padding="7,3"
                        Background="{ThemeResource CanvasBrush}" BorderThickness="1"
                        BorderBrush="{ThemeResource HairlineBrush}">
                    <TextBlock Text="Equirectangular projection · no basemap tiles" FontSize="10"
                               Foreground="{ThemeResource InkFaintBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
