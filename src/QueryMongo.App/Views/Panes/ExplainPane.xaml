<UserControl
    x:Class="QueryMongo.App.Views.Panes.ExplainPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:QueryMongo.App.Controls"
    xmlns:vm="using:QueryMongo.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnRefresh" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"
                               Text="{x:Bind Model.Summary, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind Model.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                </StackPanel>

                <!-- Totals -->
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <Border Style="{StaticResource StatTileStyle}" Padding="12,8" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="Returned" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold"
                                       Text="{x:Bind Model.Returned, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTileStyle}" Padding="12,8" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="Docs examined" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold"
                                       Text="{x:Bind Model.DocsExamined, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTileStyle}" Padding="12,8" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="Keys examined" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold"
                                       Text="{x:Bind Model.KeysExamined, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTileStyle}" Padding="12,8" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="Execution time" Style="{StaticResource StatLabelStyle}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold"
                                       Text="{x:Bind Model.ExecutionTime, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ItemsControl>

                <InfoBar Severity="Warning" IsClosable="False" Title="Inefficient query"
                         IsOpen="{x:Bind Model.IsInefficient, Mode=OneWay}"
                         Message="{x:Bind Model.InefficiencyMessage, Mode=OneWay}" />

                <InfoBar Severity="Error" IsClosable="False"
                         IsOpen="{x:Bind c:Converters.HasText(Model.ErrorMessage), Mode=OneWay}"
                         Message="{x:Bind Model.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Pivot Grid.Row="1" Padding="12,0,0,0">

            <!-- Visual plan tree -->
            <PivotItem Header="Execution plan">
                <ScrollViewer Padding="8,8,20,20">
                    <ItemsControl ItemsSource="{x:Bind Model.Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExplainNodeViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indent grows with depth, so nesting is readable -->
                                    <Border Grid.Column="0" Width="{x:Bind Indent}" />

                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                                            Margin="0,0,0,8" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="3" Padding="7,3"
                                                        Background="{ThemeResource CanvasBrush}"
                                                        BorderThickness="1"
                                                        BorderBrush="{ThemeResource HairlineBrush}">
                                                    <TextBlock Text="{x:Bind Stage}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{StaticResource CodeFontFamily}" />
                                                </Border>

                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Text="{x:Bind Description}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind Returned}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource InkFaintBrush}" />
                                                    <TextBlock Text="{x:Bind Examined}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind c:Converters.Visible(ShowExamined)}"
                                                               Foreground="{ThemeResource InkFaintBrush}" />
                                                    <TextBlock Text="{x:Bind Elapsed}" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource InkFaintBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{x:Bind IndexDescription}" FontSize="11"
                                                       FontFamily="{StaticResource CodeFontFamily}"
                                                       Foreground="{ThemeResource AccentGreenBrush}"
                                                       Visibility="{x:Bind c:Converters.Visible(HasIndex)}" />

                                            <Border CornerRadius="3" Padding="8,5"
                                                    Background="{ThemeResource CanvasBrush}"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource WarningBrush}"
                                                    Visibility="{x:Bind c:Converters.Visible(HasAdvice)}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                                              Foreground="{ThemeResource WarningBrush}" />
                                                    <TextBlock Text="{x:Bind Advice}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource WarningBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>

            <!-- Raw output -->
            <PivotItem Header="Raw output">
                <ScrollViewer Padding="8,8,20,20" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled">
                    <TextBlock Style="{StaticResource CodeTextBlockStyle}" TextWrapping="NoWrap"
                               c:JsonHighlight.Json="{x:Bind Model.RawJson, Mode=OneWay}" />
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
