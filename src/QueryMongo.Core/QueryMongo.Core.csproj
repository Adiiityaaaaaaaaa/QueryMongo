<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows-targeted because the connection store uses DPAPI, but deliberately free
      of any WinUI reference: everything here is testable without a UI thread.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>QueryMongo.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
